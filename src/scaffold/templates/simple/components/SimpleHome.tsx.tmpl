"use client";

/* THE SIMPLE VIEW. What the agent does, the one thing waiting for you, and the details behind
 * disclosures. It reads the same queue client as the Console, so switching views never starts a
 * second request or loses an edit. */

import { useEffect, useState, type ReactNode } from "react";
import Disclosure from "./Disclosure";
import Mark from "./Mark";
import { clockText, secondsLeft, useQueue } from "@/lib/use-queue";

function useTick(ms = 1000) {
  const [, set] = useState(0);
  useEffect(() => {
    const t = setInterval(() => set((n) => n + 1), ms);
    return () => clearInterval(t);
  }, [ms]);
}

export default function SimpleHome({ footer }: { footer?: ReactNode }) {
  const q = useQueue();
  useTick();
  const now = q.serverNow();
  const artifacts = q.data?.artifacts ?? [];
  const held = artifacts.filter((a) => a.status === "held").sort((x, y) => x.createdAt.localeCompare(y.createdAt));
  const queued = artifacts.filter((a) => a.status === "queued");
  const next = held[0];
  const evidence = next ? (q.data?.events ?? []).filter((e) => e.itemId === next.itemId).flatMap((e) => e.evidence) : [];

  return (
    <>
      <header className="sv-nav">
        <span className="brand">
          <Mark /> {{APP_NAME}}
        </span>
        <nav aria-label="Main navigation">
          <a href="#next">Waiting for you</a>
          <a href="#how">How it works</a>
        </nav>
      </header>
      <main className="sv-home">
        <section className="sv-hero">
          <div className="sv-pitch">
            <span className="label">APPROVAL BEFORE EVERY SEND</span>
            <h1>The agent writes the reply. You approve it before it is sent.</h1>
            <p>
              The agent reads new messages, drafts an answer to each one it may answer, and hands the rest to you. Nothing is
              sent until you approve it. After you approve, you have {q.data?.undoSeconds ?? 120} seconds to undo.
            </p>
          </div>
          <div className="sv-card" id="next">
            {q.error ? <p className="error-line" role="alert">{q.error}</p> : null}
            {queued.map((a) => {
              const left = secondsLeft(a, now);
              return (
                <div className="sv-undo" key={a.id}>
                  <span>
                    {a.payload.subject ?? a.kind}: {left > 0 ? `can be sent in ${clockText(left)}` : "waiting for the dispatcher"}
                  </span>
                  <button className="btn" type="button" onClick={() => q.undo(a.id)} disabled={!!q.busy}>
                    Undo
                  </button>
                </div>
              );
            })}
            {!q.data ? <p className="sv-note">Loading.</p> : null}
            {q.data && !next ? (
              <>
                <h2>Nothing is waiting for you.</h2>
                <p className="sv-note">New drafts appear here after the next pass.</p>
              </>
            ) : null}
            {next ? (
              <>
                <span className="label">
                  WAITING FOR YOU: {held.length}
                </span>
                <h2>{next.payload.subject ?? next.kind}</h2>
                <pre>{next.payload.body ?? JSON.stringify(next.payload, null, 2)}</pre>
                {next.reason ? <p className="sv-note">{next.reason}</p> : null}
                <div className="sv-actions">
                  <button className="btn btn-primary" type="button" onClick={() => q.approve(next.id)} disabled={!!q.busy}>
                    Approve
                  </button>
                  <button className="btn" type="button" onClick={() => q.reject(next.id)} disabled={!!q.busy}>
                    Reject
                  </button>
                </div>
                <Disclosure title="Why the agent wrote this">
                  {evidence.length ? (
                    <ul>
                      {evidence.map((e, i) => (
                        <li key={i}>{e.label}</li>
                      ))}
                    </ul>
                  ) : (
                    <p>No evidence was recorded for this draft.</p>
                  )}
                </Disclosure>
              </>
            ) : null}
            {q.data?.dev ? (
              <Disclosure title="Development tools">
                <p>The mailbox lives in memory while you develop.</p>
                <div className="sv-actions">
                  <button className="btn" type="button" onClick={() => q.dev("deliver")} disabled={!!q.busy}>
                    Deliver a sample message
                  </button>
                  <button className="btn" type="button" onClick={() => q.dev("pass")} disabled={!!q.busy}>
                    Run a pass
                  </button>
                  <button className="btn" type="button" onClick={() => q.dev("dispatch")} disabled={!!q.busy}>
                    Run the dispatcher
                  </button>
                </div>
              </Disclosure>
            ) : null}
          </div>
        </section>
        <section className="sv-section" id="how">
          <h2>How it works</h2>
          <Disclosure title="What the agent does on each pass">
            <p>It reads messages that arrived since the last pass. It labels each one. Complaints, legal questions and cancellations go to you with no draft. Automated mail and spam are recorded and left alone. Everything else gets a draft.</p>
          </Disclosure>
          <Disclosure title="What approval and undo mean">
            <p>Approve does not send. It starts a {q.data?.undoSeconds ?? 120} second window, and the dispatcher only picks up a reply after the window closes. Undo inside the window cancels it, and nothing reaches the customer.</p>
          </Disclosure>
          <Disclosure title="Limits for today">
            {q.data ? (
              <>
                <p>
                  {q.data.sentToday} of {q.data.caps.actionsPerDay} replies have been sent today. When the limit is reached, the rest wait for you.
                </p>
                <p>
                  {q.data.inferenceToday} of {q.data.caps.inferencePerDay} model calls have been used today. When the limit is reached, new messages go to you with no draft.
                </p>
              </>
            ) : (
              <p>Loading.</p>
            )}
          </Disclosure>
          <Disclosure title="The record">
            <p>Every step writes a row: what was read, how it was labelled, what was drafted, who approved it and what was sent. The record is written before each send.</p>
            <ul>
              {[...(q.data?.events ?? [])]
                .reverse()
                .slice(0, 12)
                .map((e) => (
                  <li key={e.id}>
                    {new Date(e.at).toLocaleTimeString()}: {e.title}
                  </li>
                ))}
            </ul>
          </Disclosure>
        </section>
      </main>
      {footer ?? <footer className="sv-footer">{{APP_NAME}}</footer>}
    </>
  );
}
