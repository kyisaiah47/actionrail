# The bearer your scheduler sends to /api/cron/pass and /api/cron/dispatch.
# While it is unset, both routes refuse every caller.
CRON_SECRET=

# Bring your own model. Leave ACTIONRAIL_PROVIDER empty to run the rule and template steps only.
# ACTIONRAIL_PROVIDER: openai, anthropic, gemini or openai-compatible
ACTIONRAIL_PROVIDER=
ACTIONRAIL_MODEL=
ACTIONRAIL_API_KEY=
# For openai-compatible, for example a local model: http://localhost:11434/v1
ACTIONRAIL_BASE_URL=
